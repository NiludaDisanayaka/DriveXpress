        background-position: center;
        position: relative;
    }

    .finance-side-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(41, 128, 185, 0.85);
        border-radius: 12px;
    }

    .finance-side-section > * {
        position: relative;
        z-index: 1;
    }

    .finance-side-section h2 {
        font-size: 28px;
        margin-top: 0;
        margin-bottom: 10px;
        color: white;
    }

    .finance-side-section .subtitle {
        font-size: 16px;
        opacity: 0.95;
        margin-bottom: 30px;
        font-weight: 500;
    }

    .finance-features {
        list-style: none;
        padding-left: 0;
        margin-bottom: 30px;
    }

    .finance-features li {
        padding: 18px 0;
        border-bottom: 1px solid rgba(255,255,255,0.25);
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }

    .finance-features li:last-child {
        border-bottom: none;
    }

    .finance-icon {
        color: #2980b9;
        font-size: 22px;
        background: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }

    .finance-text strong {
        display: block;
        font-size: 20px;
        margin-bottom: 8px;
        color: white;
    }

    .finance-text p {
        margin: 0;
        opacity: 0.9;
        font-size: 15px;
        line-height: 1.6;
    }

    .finance-benefits {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 10px;
        padding: 20px;
        margin: 25px 0;
        backdrop-filter: blur(5px);
    }

    .benefit-item {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
        padding: 8px 0;
    }

    .benefit-item:last-child {
        margin-bottom: 0;
    }

    .benefit-icon {
        color: #2ecc71;
        font-size: 18px;
    }

