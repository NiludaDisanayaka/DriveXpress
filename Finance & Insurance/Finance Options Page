        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: white;
        color: #2980b9;
        padding: 18px 35px;
        border: none;
        border-radius: 50px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        width: 100%;
        text-align: center;
        margin-top: 15px;
