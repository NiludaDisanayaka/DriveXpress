        margin:50px auto;
        background:#3498db;
        color: white;
        padding:16px 35px;
        border:none;
        cursor:pointer;
        font-size:18px;
        border-radius:6px;
        font-weight: bold;
        transition: all 0.3s ease;
        box-shadow: 0 6px 15px rgba(52, 152, 219, 0.3);
        max-width: 320px;
    }

    .button:hover{
        background:#2980b9;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(52, 152, 219, 0.4);
    }

   
