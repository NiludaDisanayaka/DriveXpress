  <style>
    :root{
      --bg: #f3f5f7;
      --primary: #1f6fb3;
      --muted: #9aa3ab;
      --card: #ffffff;
      --accent: #b98f8f; 
      --accent-2: rgba(185,143,143,0.08);
      --radius: 12px;
      --maxw: 1100px;
      --gap: 20px;
      --text: #222;
      font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    html,body{
      height:100%;
      margin:0;
      background:var(--bg);
      color:var(--text);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
    }

    .page {
      max-width: var(--maxw);
      margin: 36px auto;
      box-shadow: 0 6px 0 rgba(0,0,0,0.05);
      background: linear-gradient(180deg, #ffffff 0%, #ffffff 100%);
      border-radius: 6px;
      overflow: hidden;
      padding: 28px;
    }

    /* Top hero / search area */
    .hero {
      background: linear-gradient(#eef2f4, #f7f8f9);
      padding: 40px 28px;
      border-radius: 6px;
      text-align: center;
      position: relative;
    }

    .hero h1{
      margin: 0 0 12px;
      font-size: 20px;
      letter-spacing: 0.2px;
      color: #333;
      font-weight: 600;
    }
    .hero p{
      margin:0 0 22px;
      color:var(--muted);
      font-size: 14px;
    }

    /* Search card */
    .search-card{
      width: clamp(320px, 78%, 760px);
      margin: 0 auto;
      background: var(--accent);
      border-radius: var(--radius);
      padding: 18px;
      box-shadow: 0 8px 18px rgba(0,0,0,0.06);
    }

    .search-row{
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
      justify-content:center;
    }

    .select{
      min-width: 140px;
      flex: 1 1 140px;
    }

    label{
      font-size: 12px;
      color: #3f2f2f;
      display:block;
      margin-bottom:6px;
      font-weight:600;
    }

    select, input[type="text"]{
      width:100%;
      padding:10px 12px;
      border-radius:8px;
      border: none;
      outline: none;
      font-size:14px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
      background: white;
    }

    .search-button{
      display:flex;
      align-items:center;
      gap:10px;
      background: #fff;
      border-radius: 10px;
      padding: 10px 14px;
      border: none;
      cursor:pointer;
      min-width: 88px;
      justify-content:center;
      font-weight:700;
      letter-spacing:0.2px;
    }

    /* section heading */
    .section-head{
      margin: 28px 8px 14px;
      font-size:16px;
      font-weight:600;
      color:#333;
    }
    
    /* grid */
    .grid{
      display:grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--gap);
      padding: 8px;
    }

    .card{
      background: var(--card);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 8px 18px rgba(15,20,25,0.04);
      display:flex;
      flex-direction:column;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .card:hover{
      transform: translateY(-6px);
      box-shadow: 0 18px 30px rgba(15,20,25,0.08);
    }

    .card img{
      width:100%;
      height:150px;
      object-fit:cover;
      display:block;
    }

    .card-body{
      padding:12px 14px;
      display:flex;
      flex-direction:column;
      gap:8px;
      flex:1;
    }

    .meta{
      font-size:12px;
      color:var(--muted);
    }

    .title{
      font-size:15px;
      font-weight:700;
      color:#111;
      margin:0;
      line-height:1.2;
    }

    .excerpt{
      font-size:13px;
      color:#555;
      margin-top:6px;
      flex:1;
    }

    /* small layout adjustments */
    @media (max-width:520px){
      .search-row { gap:8px; }
      .search-button{ min-width:72px; padding:8px 10px; }
      .card img { height:130px; }
    }

    /* tiny utility */
    .row { display:flex; gap:12px; align-items:center; }
    .chip {
      font-size:12px;
      padding:6px 8px;
      border-radius:999px;
      background:var(--accent-2);
      color:#4a2d2d;
      font-weight:600;
    }
  </style>
