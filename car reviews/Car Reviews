  <script>
    
    function performSearch() {
      const make = document.getElementById('make').value.toLowerCase();
      const model = document.getElementById('model').value.toLowerCase();
      const q = document.getElementById('q').value.trim().toLowerCase();

      const cards = Array.from(document.querySelectorAll('#cardsContainer .card'));

      cards.forEach(card => {
        const title = card.querySelector('.title').textContent.toLowerCase();
        const excerpt = card.querySelector('.excerpt') ? card.querySelector('.excerpt').textContent.toLowerCase() : '';
        const cardMake = (card.getAttribute('data-make') || '').toLowerCase();

        // Filter by make if selected
        let visible = true;
        if (make && make !== '') {
          visible = cardMake === make;
        }

        // Filter by model if selected (example: dataset doesn't have models; adjust if you add them)
        if (visible && model && model !== '') {
          // in a real dataset you'd compare card.dataset.model
          visible = title.includes(model) || excerpt.includes(model);
        }

        // Text search across title and excerpt
        if (visible && q) {
          visible = (title + ' ' + excerpt).includes(q);
        }

        card.style.display = visible ? '' : 'none';
      });
    }

    // Optional: show all initially; attach enter key to search input
    document.getElementById('q').addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); performSearch(); }
    });

    // If you later populate cards dynamically, re-run performSearch() after loading.
  </script>
    
